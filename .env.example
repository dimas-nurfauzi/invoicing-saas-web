# Copy to .env.local (git-ignored) to override. Defaults work with the backend on :8080.

# Where the Vite dev server proxies /api (server-side, not exposed to the browser).
BACKEND_URL=http://localhost:8080

# Leave empty to go through the dev proxy (recommended). Set e.g. http://localhost:8080 to call
# the backend directly from the browser; the backend then needs CORS_ALLOWED_ORIGINS to include
# this app's origin (http://localhost:5173).
VITE_API_BASE_URL=
